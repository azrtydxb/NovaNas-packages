# /var/lib/nova-plugins/object-storage/etc/rustfs.env
# Runtime configuration for the RustFS systemd unit, packaged as the
# NovaNAS Tier 2 object-storage plugin.
#
# Variable names verified against the canonical source-of-truth file:
#   crates/config/src/constants/oidc.rs in rustfs/rustfs (main branch).
#
# Pinned RustFS release: 1.0.0-beta.1.
#
# The Tier 2 plugin engine populates RUSTFS_IDENTITY_OPENID_CLIENT_SECRET
# in this file when it provisions the Keycloak client (see
# manifest.yaml needs.oidcClient). All other values are operator-tunable.

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Data directory(s) — the ZFS dataset tank/objects, mounted by the engine.
RUSTFS_VOLUMES=/var/lib/nova-plugins/object-storage/data

# -----------------------------------------------------------------------------
# Network — S3 API
# -----------------------------------------------------------------------------
RUSTFS_ADDRESS=:9000

# -----------------------------------------------------------------------------
# Console (separate port; SSO-protected)
# -----------------------------------------------------------------------------
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_ADDRESS=:9001

# -----------------------------------------------------------------------------
# Root credentials — bootstrap only. Rotate before exposing the service.
# -----------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=CHANGE_ME_ROTATE_BEFORE_PRODUCTION

# -----------------------------------------------------------------------------
# TLS — cert + key are written here by the engine via needs.tlsCert.
# -----------------------------------------------------------------------------
RUSTFS_TLS_PATH=/var/lib/nova-plugins/object-storage/certs

# -----------------------------------------------------------------------------
# Observability / logging
# -----------------------------------------------------------------------------
RUSTFS_OBS_LOGGER_LEVEL=info
RUSTFS_OBS_LOG_DIRECTORY=/var/lib/nova-plugins/object-storage/log/

# -----------------------------------------------------------------------------
# OIDC / IAM federation with Keycloak (realm: novanas)
# -----------------------------------------------------------------------------
RUSTFS_IDENTITY_OPENID_ENABLE=on
RUSTFS_IDENTITY_OPENID_CONFIG_URL=https://192.168.10.204:8443/realms/novanas/.well-known/openid-configuration
RUSTFS_IDENTITY_OPENID_CLIENT_ID=rustfs
# Populated by the Tier 2 engine's oidcClient provisioner.
RUSTFS_IDENTITY_OPENID_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
RUSTFS_IDENTITY_OPENID_SCOPES=openid,profile,email,roles
RUSTFS_IDENTITY_OPENID_GROUPS_CLAIM=groups
RUSTFS_IDENTITY_OPENID_ROLES_CLAIM=roles
RUSTFS_IDENTITY_OPENID_CLAIM_NAME=groups
RUSTFS_IDENTITY_OPENID_REDIRECT_URI=https://novanas.local:9001/rustfs/console/oauth_callback
RUSTFS_IDENTITY_OPENID_ROLE_POLICY=
RUSTFS_IDENTITY_OPENID_USERNAME_CLAIM=preferred_username
RUSTFS_IDENTITY_OPENID_EMAIL_CLAIM=email
